[include]
  path = ~/.config/delta/themes.gitconfig

[user]
	email = no-prophet@proton.me
	name = daxisunder
	signingkey = 23F3F6B503FE2EB3FD09B6B95F4D72AEEA52C403

[github]
  user = daxisunder

[core]
  pager = delta -w ${FZF_PREVIEW_COLUMNS:-$COLUMNS}
  ignoreCase = true

[apply]
  whitespace = fix

[grep]
  lineNumber = true

[init]
  defaultBranch = main

[branch]
  sort = -committerdate

[color]
  ui = true

[log]
  decorate = short
	date = iso

[help]
  autocorrect = prompt

[interactive]
  diffFilter = delta --color-only --features=interactive

[delta]
  dark = true
  features = arctic-fox,decorations
  hyperlinks = true
  line-numbers = true
  navigate = true
  side-by-side = true
  true-color = always

[diff]
  colorMoved = default
  tool = nvimdiff

[merge]
  summary = true
  conflictStyle = zdiff3

[mergetool "nvimdiff"]
	layout = LOCAL,BASE@,REMOTE

[pull]
	rebase = false

[commit]
	gpgsign = true

[tag]
	gpgSign = true

[credential "https://github.com"]
  helper =
	helper = !/usr/bin/gh auth git-credential

[credential "https://gist.github.com"]
  helper =
	helper = !/usr/bin/gh auth git-credential
