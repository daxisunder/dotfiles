simplified_ui false
pane_frames true

layout {
    default_tab_template {
        children
        pane size=1 borderless=true {
            plugin location="file:~/.config/zellij/plugins/zjstatus.wasm" {
                format_left                "{mode} #[fg=#292e42]󰇘 {tabs} #[fg=#292e42]󰇘 #[fg=#9ece6a]{swap_layout}"
                format_center              "#[fg=#292e42]󰇘 #[fg=#7dcfff]{session} #[fg=#292e42]󰇘"
                format_right               "#[fg=#292e42]󰇘 {command_git_branch} #[fg=#292e42]󰇘 #[fg=#7aa2f7]{datetime}"
                format_space               "#[fg=#faba4a] "
                hide_frame_for_single_pane "false"
                border_enabled             "false"
                mode_normal                "#[fg=#faba4a]NORMAL"
                mode_locked                "#[fg=#f7768e]LOCKED"
                mode_tmux                  "#[fg=#7dcfff]TMUX"
                mode_resize                "#[fg=#f7768e]RESIZE"
                mode_pane                  "#[fg=#7dcfff]PANE"
                mode_tab                   "#[fg=#7dcfff]TAB"
                mode_scroll                "#[fg=#9ece6a]SCROLL"
                mode_enter_search          "#[fg=#7aa2f7]{name}"
                mode_search                "#[fg=#7aa2f7]SEARCH"
                mode_rename_tab            "#[fg=#f7768e]{name}"
                mode_rename_pane           "#[fg=#f7768e]{name}"
                mode_session               "#[fg=#9ece6a]SESSION"
                mode_move                  "#[fg=#f7768e]MOVE"
                mode_prompt                "#[fg=#9ece6a]PROMPT"

                // formatting for inactive tabs
                tab_normal                 "#[fg=#6e7a99]{name}"
                tab_normal_fullscreen      "#[fg=#6e7a99]{name}"
                tab_normal_sync            "#[fg=#6e7a99]{name}"

                // formatting for the current active tab
                tab_active                 "#[fg=#7dcfff]{name}#[fg=#faba4a]{floating_indicator}"
                tab_active_fullscreen      "#[fg=#faba4a]{name}#[fg=#faba4a]{fullscreen_indicator}"
                tab_active_sync            "#[fg=#9ece6a]{name}#[fg=#faba4a]{sync_indicator}"

                // separator between the tabs
                tab_separator              "#[fg=#292e42]:"

                // format when renaming a tab
                tab_rename                 "#[fg=#f7768e] {index} {name} {floating_indicator} "

                // indicators
                tab_sync_indicator         "  "
                tab_fullscreen_indicator   "  "
                tab_floating_indicator     " 󰉧 "

                // git branch indicator
                command_git_branch_command     "git branch --show-current"
                command_git_branch_format      "#[fg=#9ece6a]{stdout}#[fg=#c0caf5]local#[fg=#292e42]:#[fg=#f7768e]main #[fg=#9ece6a]"
                command_git_branch_interval    "1"
                command_git_branch_rendermode  "static"

                // limit tab display count
                tab_display_count          "3"  // limit to showing 3 tabs
                tab_truncate_start_format  "#[fg=#f7768e,bg=#000000] < + {count} ..."
                tab_truncate_end_format    "#[fg=#f7768e,bg=#000000] ... + {count} >"

                // date/time formatting
                datetime                   "#[fg=#7aa2f7]{format}"
                datetime_format            "%A, %d %b %Y %H:%M"
                datetime_timezone          "Europe/Luxembourg"
            }
        }
    }
    tab name="tab 1" focus=true borderless=false
    tab name="tab 2"
    tab name="tab 3"
}
